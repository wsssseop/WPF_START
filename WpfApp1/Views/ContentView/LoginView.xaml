<base:BaseUserControl x:Class="WpfApp1.Views.ContentView.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp1.Views.ContentView"
             xmlns:helper="clr-namespace:Core.Helpers;assembly=Core"
             xmlns:base="clr-namespace:WpfApp1.Base"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="700">

    <Border Background="Transparent">
        <Grid>



            <!-- main content scroll-->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                          >
                <StackPanel TextBlock.TextAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <!-- login main -->
                    <Border Background="{StaticResource ForegroundLightBrush}"
                            CornerRadius="10" Padding="15 50 15 15"
                            Width="330" 
                            Margin="50 50 50 0">
                        <StackPanel>
                            <TextBlock Text="Sign Up" FontSize="40" 
                                   Foreground="CadetBlue"/>

                            <TextBlock Text="It's about to get fun" FontSize="20" 
                                   Foreground="DimGray"
                                       Margin=" 0 0 0 20"
                                       />


                            <TextBox Text="{Binding Email}" Tag="Email"/>
                            <PasswordBox x:Name="PasswordText"
                                Tag="Password" Margin="0 0 0 30"/>
                            
                            <Button Content="Login" HorizontalAlignment="Center" 
                                    helper:IsBusyHelper.Value="{Binding LoginCommand.IsRunning}"
                                    Command="{Binding LoginCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=local:LoginView}}"
                                    
                                    />

                        </StackPanel>

                    </Border>

                    <Button Style="{StaticResource TextButton}"  Content="I already have an account" HorizontalAlignment="Center"
                           />

                    <!--<ComboBox IsEditable="True"  Margin="5 0"
                              x:Name="cmb"
                              helper:ComboBoxBackgroundHelper.Background="Yellow"
                              />-->

                    <!--<TextBlock Text="{Binding MyText}"/>
                    <TextBox Text="{Binding MyText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="{Binding Test}" />-->


                </StackPanel>
                
            </ScrollViewer>
        </Grid>
    </Border>
</base:BaseUserControl >
