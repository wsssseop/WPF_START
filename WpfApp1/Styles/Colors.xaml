<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 규칙: Color는 기본 이름, Brush는 이름 뒤에 Brush -->
    <!-- Color: ColorAnimation, GradientStop, DropShadowEffect 등 -->
    <!-- Brush: Background, Foreground, BorderBrush 등 -->

    <!-- Background -->
    <Color x:Key="BackgroundLight">#EFEFEF</Color>
    <Color x:Key="BackgroundVeryLight">#FAFAFA</Color>

    <SolidColorBrush x:Key="BackgroundLightBrush" Color="{StaticResource BackgroundLight}"/>
    <SolidColorBrush x:Key="BackgroundVeryLightBrush" Color="{StaticResource BackgroundVeryLight}"/>

    <!-- Foreground -->
    <Color x:Key="ForegroundMain">#686868</Color>
    <Color x:Key="ForegroundVeryDark">#000000</Color>
    <Color x:Key="ForegroundLight">#FFFFFF</Color>

    <SolidColorBrush x:Key="ForegroundMainBrush" Color="{StaticResource ForegroundMain}"/>
    <SolidColorBrush x:Key="ForegroundVeryDarkBrush" Color="{StaticResource ForegroundVeryDark}"/>
    <SolidColorBrush x:Key="ForegroundLightBrush" Color="{StaticResource ForegroundLight}"/>

    <!-- Button (WPF 기본 버튼 색상) -->
    <Color x:Key="Button.Static.Background">#FFDDDDDD</Color>
    <Color x:Key="Button.Static.Border">#FF707070</Color>
    <Color x:Key="Button.MouseOver.Background">#FFBEE6FD</Color>
    <Color x:Key="Button.MouseOver.Border">#FF3C7FB1</Color>
    <Color x:Key="Button.Pressed.Background">#FFC4E5F6</Color>
    <Color x:Key="Button.Pressed.Border">#FF2C628B</Color>
    <Color x:Key="Button.Disabled.Background">#FFF4F4F4</Color>
    <Color x:Key="Button.Disabled.Border">#FFADB2B5</Color>
    <Color x:Key="Button.Disabled.Foreground">#FF838383</Color>

    <SolidColorBrush x:Key="Button.Static.BackgroundBrush" Color="{StaticResource Button.Static.Background}"/>
    <SolidColorBrush x:Key="Button.Static.BorderBrush" Color="{StaticResource Button.Static.Border}"/>
    <SolidColorBrush x:Key="Button.MouseOver.BackgroundBrush" Color="{StaticResource Button.MouseOver.Background}"/>
    <SolidColorBrush x:Key="Button.MouseOver.BorderBrush" Color="{StaticResource Button.MouseOver.Border}"/>
    <SolidColorBrush x:Key="Button.Pressed.BackgroundBrush" Color="{StaticResource Button.Pressed.Background}"/>
    <SolidColorBrush x:Key="Button.Pressed.BorderBrush" Color="{StaticResource Button.Pressed.Border}"/>
    <SolidColorBrush x:Key="Button.Disabled.BackgroundBrush" Color="{StaticResource Button.Disabled.Background}"/>
    <SolidColorBrush x:Key="Button.Disabled.BorderBrush" Color="{StaticResource Button.Disabled.Border}"/>
    <SolidColorBrush x:Key="Button.Disabled.ForegroundBrush" Color="{StaticResource Button.Disabled.Foreground}"/>

    <!-- Word 테마 -->
    <Color x:Key="WordBlue">CadetBlue</Color>
    <Color x:Key="WordLightBlue">#45B6E5</Color>
    <Color x:Key="WordDarkBlue">#0C6991</Color>

    <SolidColorBrush x:Key="WordBlueBrush" Color="{StaticResource WordBlue}"/>
    <SolidColorBrush x:Key="WordLightBlueBrush" Color="{StaticResource WordLightBlue}"/>
    <SolidColorBrush x:Key="WordDarkBlueBrush" Color="{StaticResource WordDarkBlue}"/>

    <!-- TextBox -->
    <Color x:Key="TextBox.MouseOver.Border">#FF7EB4EA</Color>
    <Color x:Key="TextBox.Focus.Border">#FF569DE5</Color>

    <SolidColorBrush x:Key="TextBox.MouseOver.BorderBrush" Color="{StaticResource TextBox.MouseOver.Border}"/>
    <SolidColorBrush x:Key="TextBox.Focus.BorderBrush" Color="{StaticResource TextBox.Focus.Border}"/>

</ResourceDictionary>
